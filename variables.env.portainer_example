# Domain name of the eScriptorium instance
DOMAIN=escriptorium.domain.edu
SECRET_KEY=changeme

# change this to a comma separated list of trusted origins
# cf https://docs.djangoproject.com/en/4.0/ref/settings/#csrf-trusted-origins
# exp: http://*.mydomain.com,https://*.mydomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.upenn.edu
# if using a proxy in front of docker
USE_X_FORWARDED_HOST=True

DEBUG=True

SITE_NAME=escriptorium
REDIS_HOST=redis
REDIS_PORT=6379
SQL_HOST=db
SQL_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hard-to-guess-password
POSTGRES_DB=escriptorium

DJANGO_SU_NAME=admin
DJANGO_SU_EMAIL=address@domain.edu
DJANGO_SU_PASSWORD=hard-to-guess-password
DJANGO_FROM_EMAIL=address@domain.edu
DJANGO_SETTINGS_MODULE=escriptorium.local_settings

FLOWER_BASIC_AUTH=flower:changeme

EMAIL_HOST=smtp.host.com
SERVER_EMAIL=address@domain.edu
EMAIL_SUBJECT_PREFIX="[eScriptorium] "

# Host name of the eScriptorium instance; may include protocol and port
ESCRIPTORIUM_HOST=escriptorium.domain.edu
# Set image default to no greater than 1800px on a side
IIIF_IMPORT_QUALITY='!1800,1800'

KETOS_WORKERS=8

HPC_HOSTNAME=gpc2.sas.upenn.edu
HPC_SSH_KEYFILE=/usr/src/app/.ssh/id_ed25519
HPC_WORKING_DIR=user_home_dir
# Username on HPC cluster if all training runs as single user
HPC_SSH_USER=hpc_user_name

HTR2HPC_IMAGE_TAG=latest
HTR2HPC_NGINX_IMAGE_TAG=latest
