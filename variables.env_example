DOMAIN=localhost
SECRET_KEY=changeme

# change this to a comma separated list of trusted origins
# cf https://docs.djangoproject.com/en/4.0/ref/settings/#csrf-trusted-origins
# exp: http://*.mydomain.com,https://*.mydomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.upenn.edu

# if using a proxy in front of docker
# USE_X_FORWARDED_HOST=True

DEBUG=True

SITE_NAME=escriptorium
REDIS_HOST=redis
REDIS_PORT=6379
SQL_HOST=db
SQL_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=escriptorium

DJANGO_SU_NAME=admin
DJANGO_SU_EMAIL=admin@admin.com
DJANGO_SU_PASSWORD=admin
DJANGO_FROM_EMAIL=noreply@mydomain.com
DJANGO_SETTINGS_MODULE=escriptorium.local_settings
# CSRF_TRUSTED_ORIGINS=https://*.upenn.edu,http://localhost:8000

# Set image default to no greater than 1800px on a side
IIIF_IMPORT_QUALITY='!1800,1800'

KETOS_WORKERS=8

FLOWER_BASIC_AUTH=flower:changeme

EMAIL_HOST=some.host.edu
SERVER_EMAIL=user@example.com
EMAIL_SUBJECT_PREFIX="[eScriptorium] "

ESCRIPTORIUM_HOST=example.com
HPC_HOSTNAME=hpc.host.edu
HPC_SSH_KEYFILE=/usr/src/app/.ssh/id_ed25519
# Set the following if all users use the same acount; leave blank otherwise
HPC_SSH_USER=someuser
# Leave HPC_WORKING_DIR blank to use default: ${HOME}/hpc
# HPC_WORKING_DIR=
HTR2HPC_IMAGE_TAG=latest
HTR2HPC_NGINX_IMAGE_TAG=latest
